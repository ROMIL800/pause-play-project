# ---------------------------------------------------------------------------
# Production environment variables
#
# PUBLIC (VITE_*) values are compiled into the browser bundle. They are safe to
# expose — they are the same keys any visitor's browser would see.
#
# SERVER-ONLY values are read with process.env inside server functions only.
# NEVER prefix a server-only value with VITE_ and never commit real values.
# ---------------------------------------------------------------------------

# ---- PUBLIC (browser) -----------------------------------------------------
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
VITE_SUPABASE_PROJECT_ID="your-project-ref"

# ---- SERVER-ONLY (never exposed to the browser) ---------------------------
# Same URL/publishable key, used during SSR and by server functions.
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
SUPABASE_PROJECT_ID="your-project-ref"

# Service-role key: full database access, bypasses row-level security.
# Required for registration, admin panel actions, wallet credits and
# deposit/withdraw approval. Set it as a secret in your hosting provider.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxx"

# Shared secret required by the scheduled/cron HTTP endpoints under
# /api/public/*. Generate with: openssl rand -hex 32
LOVABLE_CRON_SECRET=""
