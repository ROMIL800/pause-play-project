{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "pause-play-project",

  "keep_vars": true,

  "compatibility_date": "2026-09-08",

  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true,
    },
  },
}
